generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  qdrantCollection   String
  embedding_model    String?             @default("dinov2")
  skus               Sku[]
  users              User[]
  searchFeedback     SearchFeedback[]
  searchInteractions SearchInteraction[]
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  googleSub           String?
  microsoftSub        String?
  brandId             String?
  role                UserRole?            @default(VIEWER)
  createdAt           DateTime             @default(now())
  name                String?
  passwordResetTokens PasswordResetToken[]
  brand               Brand?               @relation(fields: [brandId], references: [id])
  searchFeedback      SearchFeedback[]
  searchInteractions  SearchInteraction[]
}

enum UserRole {
  SUPER_ADMIN  // Can manage all brands, users, and system settings
  BRAND_ADMIN  // Can manage users within their brand
  BRAND_USER   // Can use search features within their brand
  VIEWER       // Can only view, no modifications
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Sku {
  id               String            @id @default(cuid())
  brandId          String
  skuCode          String
  fileName         String
  imageUrl         String
  title            String?
  qdrantPointId    String?           @db.Uuid
  metadata         Json?
  processedAt      DateTime?         @db.Timestamp(6)
  brand            Brand             @relation(fields: [brandId], references: [id])
  attr             SkuAttr?
  interactionItems InteractionItem[]

  @@index([brandId, skuCode], map: "brand_sku")
}

model SkuAttr {
  id    String @id @default(cuid())
  skuId String @unique
  attrs Json
  sku   Sku    @relation(fields: [skuId], references: [id])
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  queryType String
  threshold Float
  topK      Int
  tookMs    Int
  filters   Json?
  createdAt DateTime @default(now())
}

model SearchFeedback {
  id             String   @id
  userId         String
  brandId        String
  inputImageUrl  String
  resultImageUrl String
  resultSkuId    String
  resultSkuCode  String
  confidence     Float
  userFeedback   Boolean
  feedbackReason String?
  createdAt      DateTime @default(now())
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@index([confidence, userFeedback])
  @@index([resultSkuId])
  @@index([userId, createdAt])
}

model RequestLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId         String    @map("brand_id") @db.VarChar(255)
  endpoint        String    @db.VarChar(255)
  method          String    @db.VarChar(10)
  requestParams   Json      @map("request_params") @default("{}")
  responseStatus  Int       @map("response_status")
  responseTimeMs  Decimal   @map("response_time_ms") @db.Decimal(10, 3)
  timestamp       DateTime? @default(now()) @db.Timestamptz(6)
  userIp          String?   @map("user_ip") @db.VarChar(45)
  userAgent       String?   @map("user_agent")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime? @map("created_at") @default(now()) @db.Timestamptz(6)

  @@map("request_logs")
  @@index([brandId], map: "idx_request_logs_brand_id")
  @@index([endpoint], map: "idx_request_logs_endpoint")
  @@index([timestamp], map: "idx_request_logs_timestamp")
}

model SearchInteraction {
  id              String            @id @default(cuid())
  userId          String
  brandId         String
  inputImageUrl   String           // URL of uploaded search image
  inputImageHash  String?          // Optional: for deduplication
  searchParams    Json?            // Store search parameters (threshold, topK, etc.)
  totalResults    Int?             // How many results were returned
  createdAt       DateTime         @default(now())
  
  user            User             @relation(fields: [userId], references: [id])
  brand           Brand            @relation(fields: [brandId], references: [id])
  interactions    InteractionItem[]
  
  @@index([userId])
  @@index([brandId])
  @@index([createdAt])
}

model InteractionItem {
  id                   String             @id @default(cuid())
  searchInteractionId  String
  skuId                String
  interactionType      InteractionType
  similarityScore      Float              // Similarity when shown to user
  resultPosition       Int                // Position in search results
  createdAt            DateTime           @default(now())
  
  searchInteraction    SearchInteraction  @relation(fields: [searchInteractionId], references: [id], onDelete: Cascade)
  sku                  Sku               @relation(fields: [skuId], references: [id])
  
  @@unique([searchInteractionId, skuId])
  @@index([skuId])
  @@index([interactionType])
}

enum InteractionType {
  LIKE
  DISLIKE
}

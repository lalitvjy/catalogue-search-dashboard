generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  qdrantCollection String
  embedding_model  String? @default("dinov2")
  skus             Sku[]
  users            User[]
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  googleSub           String?
  microsoftSub        String?
  brandId             String?
  role                UserRole             @default(VIEWER)
  createdAt           DateTime             @default(now())
  name                String?
  passwordResetTokens PasswordResetToken[]
  brand               Brand?               @relation(fields: [brandId], references: [id])
}

enum UserRole {
  SUPER_ADMIN  // Can manage all brands, users, and system settings
  BRAND_ADMIN  // Can manage users within their brand
  BRAND_USER   // Can use search features within their brand
  VIEWER       // Can only view, no modifications
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Sku {
  id            String    @id @default(cuid())
  brandId       String
  skuCode       String
  fileName      String
  imageUrl      String
  title         String?
  qdrantPointId String?   @db.Uuid
  metadata      Json?
  processedAt   DateTime? @db.Timestamp(6)
  brand         Brand     @relation(fields: [brandId], references: [id])
  attr          SkuAttr?

  @@index([brandId, skuCode], map: "brand_sku")
}

model SkuAttr {
  id    String @id @default(cuid())
  skuId String @unique
  attrs Json
  sku   Sku    @relation(fields: [skuId], references: [id])
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  queryType String
  threshold Float
  topK      Int
  tookMs    Int
  filters   Json?
  createdAt DateTime @default(now())
}
